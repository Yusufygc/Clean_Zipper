  {
   "id": "py-eval",
   "title": "eval() kullanımı",
   "severity": "HIGH",
   "languages": [
    "python"
   ],
   "scope": "code",
   "pattern": "(?<![\\w.$])eval\\s*\\(",
   "flags": "",
   "cwe": "CWE-95",
   "advice": "Girdiyi eval ile çalıştırmayın; değişmez değerler için ast.literal_eval, veri için json kullanın."
  },
  {
